# OAuth broker (Vercel). Copy to .env.local for `vercel dev`, or set these as
# project environment variables in the Vercel dashboard.
#
# Create the app at https://github.com/settings/developers -> OAuth Apps ->
# "New OAuth App". Set:
#   Homepage URL:        https://iamtyroon.github.io/commitcard
#   Authorization callback URL: <your-vercel-domain>/api/callback
#
# The client_secret never reaches the browser. The page only ever sees the
# worker's JSON responses.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Exact origin allowed to make credentialed requests. No wildcard: credentialed
# CORS forbids it, and a wrong origin is rejected with 403.
ALLOWED_ORIGIN=https://iamtyroon.github.io
