    "test": "node --test test/*.test.mjs && node test/probe-svg.mjs",
    "card": "node bin/commitcard.mjs",
    "dev": "vercel dev"
  },
  "keywords": [
    "git",
    "github",
    "stats",
    "card",
    "social",
    "twitter",
    "screenshot",
    "changelog",
    "cli"
  ],
